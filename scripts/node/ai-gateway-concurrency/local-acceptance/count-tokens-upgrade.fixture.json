  "upgrade": {
    "republish": false,
    "network_install": false
  },
  "resources": {
    "reuse_local_acceptance_provenance": true,
    "reuse_owned_tmux": true,
    "finally_cleanup": true,
    "forbidden_ports": [3100, 7800, 7801]
  }
}
