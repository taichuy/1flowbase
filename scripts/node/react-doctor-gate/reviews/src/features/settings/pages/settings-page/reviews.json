    },
    {
      "file": "web/app/src/features/settings/pages/settings-page/SettingsExtensionCenterSection.tsx",
      "rule": "react-doctor/js-combine-iterations",
      "sourceSha256": "057e7b2fc42d53bac382e00330ff4c9eed933825bcc463c52ebf5b7b7f941db9",
      "reason": "The displayed source uses two linear semantic stages (select valid/authorized items, then project payload/UI) with no repeated expensive effect; original ordering and identity are intentional. GenericExtensionCenterSection owns the category-scoped installed/installable catalog and selected extension operation lifecycle. Navigation invalidates outstanding update-check generation, detail selection and filter draft. operation/delete/activation invalidate the broad application state helper; update checks await grouped server results before generation checking and applying per-row states.",
