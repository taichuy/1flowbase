# Local development example.
# Sets the Vite dev server port.
VITE_DEV_SERVER_PORT=3100
# Allows this dev server to be reached through custom hosts such as LAN or tunnel domains.
# VITE_DEV_ALLOWED_HOSTS=1flowbase.example.test
# Allows configured frontend dev origins to use this dev server as a browser-facing API proxy.
# Use comma-separated origins, or "*" only for trusted shared development.
# VITE_DEV_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Sets the target used by the Vite dev proxy for local API requests.
# Use a backend URL locally, or another exposed 1flowbase frontend origin to chain through it.
VITE_API_PROXY_TARGET=http://127.0.0.1:7800
# Browser API calls default to the current frontend origin during local development.
# Overrides the browser-side API base URL for non-proxied deployments.
# VITE_API_BASE_URL=https://api.example.com
# Overrides the API base URL displayed and used by the embedded Scalar viewer.
# VITE_SCALAR_API_BASE_URL=http://127.0.0.1:3100
