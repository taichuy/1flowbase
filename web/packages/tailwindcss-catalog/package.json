{
  "name": "@1flowbase/tailwindcss-catalog",
  "version": "0.3.4",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./inventory": {
      "types": "./dist/inventory.d.ts",
      "default": "./src/inventory.ts"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "default": "./src/compiler.ts"
    },
    "./legacy-inventory.css": "./src/legacy-inventory.css"
  },
  "dependencies": {
    "tailwindcss": "4.3.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "test": "vitest run"
  }
}
