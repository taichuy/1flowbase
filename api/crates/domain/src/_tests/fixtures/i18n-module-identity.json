{
  "grammar": "@scope/group/module[/submodule...]",
  "punctuation": "Every segment starts with a lowercase ASCII letter or digit; remaining characters are lowercase ASCII letters, digits, dot, underscore, or hyphen.",
  "valid": [
    "@taichuy/platform/common",
    "@taichuy/platform/console/settings",
    "@org/group/module.v2",
    "@org/group/module_name",
    "@org/group/module-name"
  ],
  "invalid": [
    "@org/messages",
    "@Org/group/module",
    "@org/Group/module",
    "@org/group/Module",
    "@org//group/module",
    "@org/group//module",
    "@org/group/module/",
    "@org/group/.module",
    "@org/group/module+variant"
  ]
}
