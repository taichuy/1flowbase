        "id": "node-select-applications",
        "type": "code",
        "alias": "核对应用清单",
        "config": {
          "source": "function read(status,body,label) { if(status<200||status>=300) throw new Error(label+\" HTTP \"+status+\": \"+String(body).slice(0,1000)); const value=JSON.parse(body); if(!value || !Object.prototype.hasOwnProperty.call(value,\"data\")) throw new Error(label+\" response missing data\"); return value.data; }\nfunction main(inputs) {const rows=read(inputs.status,inputs.body,\"List applications\");if(!Array.isArray(rows))throw new Error(\"Applications response is not an array\");const apps=rows.filter(a=>[\"agent_flow\",\"agent_logs\",\"workflow\"].includes(a.application_type)).map(a=>({id:a.id,name:a.name,application_type:a.application_type})).sort((a,b)=>a.id.localeCompare(b.id));return {apps};}",
          "language": "javascript",
          "entrypoint": "main"
