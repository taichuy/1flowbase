      {
        "id": "node-build-request",
        "type": "code",
        "alias": "构造正式删除请求",
        "config": {
          "source": "function jobId(run,app) {const a=run.replace(/-/g,\"\"),b=app.replace(/-/g,\"\"); if(!/^[0-9a-f]{32}$/i.test(a)||!/^[0-9a-f]{32}$/i.test(b)) throw new Error(\"Invalid run/application id\"); let s=\"\";for(let i=0;i<32;i++)s+=((parseInt(a[i],16)^parseInt(b[(i+13)%32],16))&15).toString(16);s=s.slice(0,12)+\"4\"+s.slice(13,16)+\"8\"+s.slice(17);return s.slice(0,8)+\"-\"+s.slice(8,12)+\"-\"+s.slice(12,16)+\"-\"+s.slice(16,20)+\"-\"+s.slice(20);}\nfunction main(inputs){const scope=inputs.scope;const app=inputs.app;if(!app||!app.id)throw new Error(\"Missing application\");const job_id=jobId(inputs.run,app.id);return {request:{application_id:app.id,application_name:app.name,job_id,scope,preview_body:JSON.stringify(scope),create_body:JSON.stringify({job_id,scope})}};}",
          "language": "javascript",
          "entrypoint": "main"
        },
        "outputs": [
          {
            "key": "request",
            "title": "request",
            "valueType": "object"
          }
        ],
        "bindings": {
          "app": {
            "kind": "selector",
            "value": [
              "node-each-application",
              "item"
            ]
          },
          "run": {
            "kind": "selector",
