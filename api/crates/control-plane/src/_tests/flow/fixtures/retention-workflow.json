        "config": {
          "source": "function read(status,body,label) { if(status<200||status>=300) throw new Error(label+\" HTTP \"+status+\": \"+String(body).slice(0,1000)); const value=JSON.parse(body); if(!value || !Object.prototype.hasOwnProperty.call(value,\"data\")) throw new Error(label+\" response missing data\"); return value.data; }\nfunction main(inputs){const d=read(inputs.status,inputs.body,\"Create deletion job\"),r=inputs.request;const j=d&&d.job;if(!j||j.job_id!==r.job_id||j.application_id!==r.application_id)throw new Error(\"Deletion job identity mismatch\");if(![\"queued\",\"running\",\"succeeded\"].includes(j.status))throw new Error(\"Deletion job \"+j.status+\": \"+j.error_code);if(!j.scope||j.scope.batch_size!==100)throw new Error(\"Deletion batch_size must be 100\");return {job:j};}",
          "language": "javascript",
          "entrypoint": "main"
