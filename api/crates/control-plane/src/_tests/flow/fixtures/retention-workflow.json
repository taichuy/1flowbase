      {
        "id": "node-verify-progress",
        "type": "code",
        "alias": "失败立即报错，全部完成才退出",
        "config": {
          "source": "function read(status,body,label) { if(status<200||status>=300) throw new Error(label+\" HTTP \"+status+\": \"+String(body).slice(0,1000)); const value=JSON.parse(body); if(!value || !Object.prototype.hasOwnProperty.call(value,\"data\")) throw new Error(label+\" response missing data\"); return value.data; }\nfunction main(inputs){const d=read(inputs.status,inputs.body,\"Get deletion job\"),j=d&&d.job,r=inputs.request;if(!j||j.job_id!==r.job_id||j.application_id!==r.application_id)throw new Error(\"Deletion job missing or identity mismatch\");if(![\"queued\",\"running\",\"succeeded\"].includes(j.status))throw new Error(\"Deletion job \"+j.status+\": \"+j.error_code);if(!Number.isSafeInteger(j.total_records)||!Number.isSafeInteger(j.deleted_records)||j.deleted_records<0||j.total_records<j.deleted_records)throw new Error(\"Invalid deletion counts\");if(j.status===\"succeeded\"&&j.total_records!==j.deleted_records)throw new Error(\"Deletion incomplete\");return {summary:{done:j.status===\"succeeded\",application_id:r.application_id,application_name:r.application_name,job_id:j.job_id,status:j.status,total_records:j.total_records,deleted_records:j.deleted_records,batch_size:100}};}",
          "language": "javascript",
          "entrypoint": "main"
        },
