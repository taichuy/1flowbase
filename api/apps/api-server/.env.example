# Local development example.
# API_ENV=development defaults to trusted local development mode:
# - CORS does not require API_ALLOWED_ORIGINS
# - credentialed browser requests from local frontend origins are allowed
API_ENV=development
API_DATABASE_URL=postgres://postgres:1flowbase@127.0.0.1:35432/1flowbase
# New runtime tables use their Code as the physical table name by default.
API_RUNTIME_TABLE_AUTO_PREFIX_ENABLED=false
# When enabled, generate a prefix from this regex and append _<code>.
API_RUNTIME_TABLE_PREFIX_REGEX=rtm_workspace_[a-z0-9]{8}
API_PLUGIN_SET=default
API_SECRET_RESOLVER=env
API_SERVER_ADDR=0.0.0.0:7800
VITE_DEV_SERVER_PORT=3100
VITE_API_PROXY_TARGET=http://127.0.0.1:7800
API_COOKIE_NAME=flowbase_console_session
API_SESSION_TTL_DAYS=7
API_TRANSPORT_SESSION_LOGICAL_MAX_AGE_SECONDS=7200
API_TRANSPORT_SESSION_INVOCATION_DEFAULT_SECONDS=1800
API_TRANSPORT_SESSION_WAITING_TOOL_LEASE_SECONDS=3300
API_TRANSPORT_SESSION_ORPHAN_GRACE_SECONDS=60
API_TRANSPORT_SESSION_IDLE_AFFINITY_LEASE_SECONDS=90
API_TRANSPORT_SESSION_PHYSICAL_SOFT_DRAIN_AGE_SECONDS=3000
API_TRANSPORT_SESSION_PHYSICAL_MAX_AGE_SECONDS=3480
# Optional operator limit on logical sessions; unset by default.
API_TRANSPORT_SESSION_TOMBSTONE_TTL_SECONDS=300
# Maximum multipart payload size, in bytes, shared by every plugin package upload endpoint (default: 8 MiB).
API_PLUGIN_UPLOAD_MAX_BYTES=50388608
# Selects the GitHub repository that hosts the official plugin registry and packages.
API_OFFICIAL_PLUGIN_REPOSITORY=taichuy/1flowbase-official-plugins
API_OFFICIAL_MODEL_PRICING_CATALOG_INDEX_URL=https://raw.githubusercontent.com/taichuy/1flowbase-official-plugins/main/model-pricing/catalog/v1/index.json
API_MODEL_PRICING_BOOTSTRAP_ROOT=/app/api/resources/model-pricing
# Fail completed, billable provider calls when the provider omits usage. Default keeps the call
# successful and records zero usage/cost with reconciliation failure evidence.
API_MODEL_BILLING_REQUIRE_PROVIDER_USAGE=false
# Points the API server to the official plugin registry manifest.
API_OFFICIAL_PLUGIN_REGISTRY_URL=https://raw.githubusercontent.com/taichuy/1flowbase-official-plugins/main/official-registry.json
# HTTP connect timeout for official extension sources, in seconds.
API_OFFICIAL_EXTENSION_SOURCE_CONNECT_TIMEOUT_SECONDS=2
# Total request timeout for official extension catalog documents, in seconds.
API_OFFICIAL_EXTENSION_CATALOG_REQUEST_TIMEOUT_SECONDS=8
# Total request timeout for official extension artifact downloads, in seconds.
API_OFFICIAL_EXTENSION_ARTIFACT_DOWNLOAD_TIMEOUT_SECONDS=300
# Requires official or mirrored plugin packages to pass trusted signature verification.
API_OFFICIAL_PLUGIN_SIGNATURE_REQUIRED=true
# Provides the trusted public keys used to verify official or delegated plugin package signatures.
API_OFFICIAL_PLUGIN_TRUSTED_PUBLIC_KEYS_JSON=[{"key_id":"1flowbase-signing-20261010-e7a2c47a","algorithm":"ed25519","public_key_pem":"-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAOMjRrNChRtu4aR+yVpFUwvOVxonoNizhWuQ4+DwJjrg=\n-----END PUBLIC KEY-----"}]
BOOTSTRAP_WORKSPACE_NAME=1flowbase
BOOTSTRAP_ROOT_ACCOUNT=root
BOOTSTRAP_ROOT_EMAIL=root@example.com
BOOTSTRAP_ROOT_PASSWORD=change-me
BOOTSTRAP_ROOT_NAME=Root
BOOTSTRAP_ROOT_NICKNAME=Root

# Optional raw supplier protocol diagnostics. Native semantic trajectory remains enabled.
# Set to 1 and restart API to opt in; bodies may contain application conversation data.
FLOWBASE_PROVIDER_PROTOCOL_CAPTURE=0

# Keep a provider process warm after all active calls and physical owners release.
# Independent of transport/session and ephemeral cache TTL; 0 reclaims immediately when safe.
API_PROVIDER_WORKER_IDLE_GRACE_SECONDS=90

# Per-event provider timing diagnostics. Default retains exact attempt summaries only.
# Set to 1 and restart API before the invocation to retain all timing records.
FLOWBASE_PROVIDER_STREAM_TIMING_CAPTURE=0

# 内置应用模板：默认启动同步，新版本覆盖模板已有定义并补齐新增资源。
# false 在空库不安装、已有库不更新；仍可从扩展中心手动安装。
API_APPLICATION_TEMPLATE_AUTO_UPDATE=true
# 可选。未设置时读取 api/resources/application-templates；不存在的目录视为空目录。
# 目录布局：ROOT/@organization/name/template.json；receipt.json 不作为模板读取。
# Docker 使用 /app/api/resources/application-templates。
# API_APPLICATION_TEMPLATE_ROOT=/app/api/resources/application-templates
