+// Temporary storage observation only; no latency/deadline/stream matrix.
+#[tokio::test(flavor = "current_thread")]
+#[ignore = "temporary W5 storage; exact entrypoint only"]
+async fn w5_probe_pending_storage() {
+    use crate::_tests::w5_runtime_cost_probe as probe;
+    use std::{future::Future, task::Poll};
+    println!("W5_LAYOUT case=pending sizes_I_O_E_P_context={:?}", probe::sizes::<Input, Output, TargetError, UserPrincipal>());
+    tokio::task::yield_now().await;
+    let s0 = probe::snapshot();
+    let cancellation = InvocationCancellation::new();
+    let snapshot = snapshot(InterfaceExecutionMode::Unary, Business::Pending, Observer::Quick, &cancellation);
+    let controls = InvocationControls::new(None, cancellation.clone(), None);
+    let base = envelope("http.review.finalization.v1", InterfaceProtocol::Http, "review.authn");
+    let request = InvocationEnvelope::with_principal_and_controls(base.lineage().clone(), base.binding_id().clone(),
+        base.protocol(), base.authentication_adapter().clone(), base.authentication_activation().clone(),
+        base.principal().clone(), controls, Input(4));
+    let kernel = InterfaceInvocationKernel::new(Arc::new(Authorization("review.authz")));
+    let call_snapshot = Arc::clone(&snapshot);
+    let window = probe::begin(); let pending; let correct;
+    {
+        let mut future = std::pin::pin!(kernel.invoke::<Input, Output, TargetError>(call_snapshot, request));
+        std::future::poll_fn(|cx| {
+            assert!(future.as_mut().poll(cx).is_pending(), "real Pending target must not finish");
+            Poll::Ready(())
+        }).await;
+        pending = probe::snapshot(); cancellation.cancel();
+        let failure = future.as_mut().await.unwrap_err();
+        let records = failure.receipt().observer_records();
+        correct = failure.receipt().stages().any(|s| s == InterfaceInvocationStage::Executing)
+            && failure.receipt().terminal() == InterfaceInvocationTerminal::Cancelled
+            && matches!(failure.error(), InterfaceInvocationError::Cancelled)
+            && records.len() == 1 && records[0].point() == InterfaceExtensionPoint::Completion
+            && records[0].status() == InterfaceObserverStatus::Executed;
+        std::hint::black_box(&failure); drop(failure);
+    }
+    let sample = window.finish(false);
+    let s4 = probe::snapshot(); // This fixture has no external event/fingerprint containers.
+    drop(kernel); drop(snapshot); drop(base); drop(cancellation);
+    let s5 = probe::snapshot(); assert!(correct);
+    probe::report("pending_storage_only", 0, sample, [s0,s4,s5], pending,
+        "source-ready authorization, empty Before, no event/doc observer; first Pending is real Business::Pending; no P/I drop-delay inference");
+}
