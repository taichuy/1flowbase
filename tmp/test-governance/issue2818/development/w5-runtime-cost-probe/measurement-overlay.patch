+async fn w5_probe_document_before() {
+    use crate::_tests::w5_runtime_cost_probe as probe;
+    let (iterations, warmup) = probe::config();
+    println!("W5_LAYOUT case=document sizes_I_O_E_P_context={:?}", probe::sizes::<Input, Output, TargetError, UserPrincipal>());
+    tokio::task::yield_now().await;
+    let mut total = Some(0);
+    for index in 0..warmup + iterations {
+        let s0 = probe::snapshot();
+        let (mut compiler, observer, legacy) = document_compiler(ObserverBehavior::Record, true, false);
+        let calls = Arc::new(AtomicUsize::new(0));
+        register_static(&mut compiler, descriptor(), Arc::clone(&calls));
+        // Same real RecordingHandler fields as bind_handler(false,false), with a retained inspection handle.
+        let seen = Arc::new(Mutex::new(None));
