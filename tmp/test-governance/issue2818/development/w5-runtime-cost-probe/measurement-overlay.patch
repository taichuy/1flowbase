+async fn w5_probe_empty_plan() {
+    use crate::_tests::w5_runtime_cost_probe as probe;
+    let (iterations, warmup) = probe::config();
+    println!("W5_LAYOUT case=empty sizes_I_O_E_P_context={:?}", probe::sizes::<Input, Output, TargetError, UserPrincipal>());
+    tokio::task::yield_now().await;
+    let mut total = Some(0);
+    for index in 0..warmup + iterations {
+        let s0 = probe::snapshot();
+        let seen = Arc::new(Mutex::new(None));
+        let snapshot = compile_snapshot("graph:one", 3, false, Arc::clone(&seen));
+        let kernel = InterfaceInvocationKernel::with_target_admission(
+            Arc::new(Authorization { reject: false }), Arc::new(Admission { reject: false }));
+        let request = envelope(actor(true)); let call_snapshot = Arc::clone(&snapshot);
+        assert!(seen.lock().unwrap().is_none());
+        let window = probe::begin();
+        let correct;
+        {
+            let future = kernel.invoke::<Input, Output, TargetError>(call_snapshot, request);
+            let outcome = future.await.unwrap();
+            correct = outcome.value().0 == 5 && outcome.receipt().terminal() == InterfaceInvocationTerminal::Completed;
+            std::hint::black_box(&outcome); drop(outcome);
+        }
+        let sample = window.finish(true);
+        let retained = seen.lock().unwrap().as_ref().map(|s| (s.len(),s.capacity()));
+        drop(seen.lock().unwrap().take());
+        let s4 = probe::snapshot();
+        drop(kernel); drop(snapshot); drop(seen);
+        let s5 = probe::snapshot(); assert!(correct && retained.is_some());
+        if index >= warmup {
+            total = total.zip(sample.nanos).map(|(total, n)| total+n);
+            probe::report("empty", index-warmup, sample, [s0,s4,s5], None, ("fingerprint_before=None", retained));
+        }
+    }
+    println!("W5_TOTAL case=empty iterations={iterations} normal_nanos={total:?} counts_timing_not_latency={}", probe::instrumented());
+}
