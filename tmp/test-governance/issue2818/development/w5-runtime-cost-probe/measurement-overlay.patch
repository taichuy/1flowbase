+            HandlerReference::new("invocation.handler").unwrap(), Arc::new(RecordingHandler {
+                increment: 3, fail: false, seen_fingerprint: Arc::clone(&seen),
+            })).unwrap();
+        let before_events = Arc::new(Mutex::new(Vec::new()));
+        let hooks = TypedInterfaceHookPlan::<Input, Output>::new(GraphFingerprint::new("graph:events").unwrap())
+            .bind_before(PluginIdentity::new("hook.mutate").unwrap(), Arc::new(RecordingBeforeHook {
+                name: "mutate", increment: 4, events: Arc::clone(&before_events),
+            }));
+        compiler.register_extension(&interface_id(), 1, hook_registration("hook.mutate", InterfaceExtensionPoint::Before)).unwrap();
+        compiler.bind_hook_plan(&interface_id(), Arc::new(hooks)).unwrap();
+        let snapshot = compiler.compile().unwrap(); let kernel = kernel(false);
+        let request = envelope(actor(true)); let call_snapshot = Arc::clone(&snapshot);
+        let initial = {
+            let d = observer.events.lock().unwrap(); let b = before_events.lock().unwrap(); let l = legacy.lock().unwrap();
+            (d.len(),d.capacity(),b.len(),b.capacity(),l.len(),l.capacity(),seen.lock().unwrap().is_none())
+        };
+        assert_eq!(initial, (0,0,0,0,0,0,true));
+        let window = probe::begin();
+        let correct;
+        {
+            let future = kernel.invoke::<Input, Output, TargetError>(call_snapshot, request);
+            let outcome = future.await.unwrap();
+            correct = outcome.value().0 == 9 && outcome.receipt().terminal() == InterfaceInvocationTerminal::Completed;
+            std::hint::black_box(&outcome); drop(outcome);
