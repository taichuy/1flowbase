+//! Temporary actual-fixture probe only; no driver or production replacements.
+#![allow(unexpected_cfgs)]
+use std::time::Instant;
+#[derive(Clone, Copy, Debug)]
+pub(super) struct Counts {
+    pub alloc: usize, pub dealloc: usize, pub realloc: usize,
+    pub allocated: usize, pub freed: usize, pub live: isize,
+}
+#[cfg(w5_heap_counts)]
+mod heap {
+    use super::Counts;
+    use std::{alloc::{GlobalAlloc, Layout, System}, sync::atomic::{AtomicBool, AtomicIsize, AtomicUsize, Ordering::SeqCst}};
+    static ALLOC: AtomicUsize = AtomicUsize::new(0);
+    static FREE: AtomicUsize = AtomicUsize::new(0);
+    static REALLOC: AtomicUsize = AtomicUsize::new(0);
+    static ADDED: AtomicUsize = AtomicUsize::new(0);
+    static REMOVED: AtomicUsize = AtomicUsize::new(0);
+    static LIVE: AtomicIsize = AtomicIsize::new(0);
+    static PEAK: AtomicIsize = AtomicIsize::new(0);
+    static ACTIVE: AtomicBool = AtomicBool::new(false);
+    struct Tracked;
+    #[global_allocator]
+    static GLOBAL: Tracked = Tracked;
+    fn changed(old: usize, new: usize) {
+        ADDED.fetch_add(new, SeqCst); REMOVED.fetch_add(old, SeqCst);
+        let live = LIVE.fetch_add(new as isize - old as isize, SeqCst) + new as isize - old as isize;
+        if ACTIVE.load(SeqCst) { PEAK.fetch_max(live, SeqCst); }
+    }
+    unsafe impl GlobalAlloc for Tracked {
+        unsafe fn alloc(&self, l: Layout) -> *mut u8 {
+            let p = System.alloc(l);
+            if !p.is_null() { ALLOC.fetch_add(1, SeqCst); changed(0, l.size()); } p
+        }
+        unsafe fn alloc_zeroed(&self, l: Layout) -> *mut u8 {
+            let p = System.alloc_zeroed(l);
+            if !p.is_null() { ALLOC.fetch_add(1, SeqCst); changed(0, l.size()); } p
+        }
+        unsafe fn dealloc(&self, p: *mut u8, l: Layout) {
+            System.dealloc(p, l); FREE.fetch_add(1, SeqCst); changed(l.size(), 0);
+        }
+        unsafe fn realloc(&self, p: *mut u8, l: Layout, n: usize) -> *mut u8 {
+            let next = System.realloc(p, l, n);
+            if !next.is_null() { REALLOC.fetch_add(1, SeqCst); changed(l.size(), n); } next
+        }
+    }
+    pub(super) fn snapshot() -> Counts { Counts {
+        alloc: ALLOC.load(SeqCst), dealloc: FREE.load(SeqCst), realloc: REALLOC.load(SeqCst),
+        allocated: ADDED.load(SeqCst), freed: REMOVED.load(SeqCst), live: LIVE.load(SeqCst),
+    } }
+    pub(super) fn start(live: isize) { PEAK.store(live, SeqCst); ACTIVE.store(true, SeqCst); }
+    pub(super) fn stop() -> isize { ACTIVE.store(false, SeqCst); PEAK.load(SeqCst) }
+}
+pub(super) fn snapshot() -> Option<Counts> {
+    #[cfg(w5_heap_counts)] { Some(heap::snapshot()) }
+    #[cfg(not(w5_heap_counts))] { None }
+}
+pub(super) struct Window { start: Instant, s1: Option<Counts> }
+pub(super) struct Sample {
+    pub nanos: Option<u128>, pub instrument_nanos: Option<u128>, pub s1: Option<Counts>, pub s3: Option<Counts>, pub peak: Option<isize>,
+}
+pub(super) fn begin() -> Window {
+    let s1 = snapshot();
+    #[cfg(w5_heap_counts)] heap::start(s1.unwrap().live);
+    Window { start: Instant::now(), s1 }
+}
+impl Window {
+    pub(super) fn finish(self, timed: bool) -> Sample {
+        let elapsed = self.start.elapsed().as_nanos();
+        #[cfg(w5_heap_counts)] let peak = Some(heap::stop());
+        #[cfg(not(w5_heap_counts))] let peak = None;
+        Sample { nanos: (timed && !cfg!(w5_heap_counts)).then_some(elapsed), instrument_nanos: cfg!(w5_heap_counts).then_some(elapsed), s1: self.s1, s3: snapshot(), peak }
+    }
+}
+pub(super) fn config() -> (usize, usize) {
+    let read = |key| std::env::var(key).expect("freeze explicit probe counts before outcomes").parse::<usize>().unwrap();
+    let iterations = read("W5_PROBE_ITERS"); let warmup = read("W5_PROBE_WARMUP");
+    assert!(iterations > 0 && warmup > 0); (iterations, warmup)
+}
+pub(super) fn sizes<I, O, E, P: crate::InvocationPrincipal>() -> [usize; 5] {
+    [std::mem::size_of::<I>(), std::mem::size_of::<O>(), std::mem::size_of::<E>(),
+     std::mem::size_of::<P>(), std::mem::size_of::<crate::InterfaceHandlerContext<P>>()]
+}
+pub(super) fn clear<T>(events: &std::sync::Mutex<Vec<T>>) {
+    let released = std::mem::take(&mut *events.lock().unwrap()); drop(released);
+}
+pub(super) fn report(case: &str, iteration: usize, sample: Sample, checkpoints: [Option<Counts>; 3], pending: Option<Counts>, state: impl std::fmt::Debug) {
+    let [s0, s4, s5] = checkpoints;
+    let delta = |a: Option<Counts>, b: Option<Counts>| a.zip(b).map(|(a,b)| b.live-a.live);
+    let live_valid = [s0,sample.s1,pending,sample.s3,s4,s5].iter().flatten().all(|s| s.live >= 0);
+    println!("W5_SAMPLE case={case} iteration={iteration} mode={} normal_nanos={:?} instrumented_window_nanos={:?} state={state:?} S0={s0:?} S1={:?} S2={pending:?} S3={:?} S4={s4:?} S5={s5:?} live_delta_S0_S5={:?} live_delta_S1_S3={:?} window_peak={:?} peak_above_S1={:?} live_nonnegative={live_valid} attribution=process_global_other_threads_unknown stack=unknown RSS=unknown",
+        if cfg!(w5_heap_counts) { "counts" } else { "normal" }, sample.nanos, sample.instrument_nanos, sample.s1, sample.s3,
+        delta(s0,s5), delta(sample.s1,sample.s3), sample.peak, sample.peak.zip(sample.s1).map(|(p,s)| p-s.live));
+}
+
+pub(super) fn instrumented() -> bool { cfg!(w5_heap_counts) }
